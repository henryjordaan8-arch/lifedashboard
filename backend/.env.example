# Copy to backend/.env and fill in. This file is gitignored.

# --- Garmin Connect (unofficial API via python-garminconnect) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
# OAuth tokens are cached here after the first login so the password (and MFA)
# is not needed on every start. Run `python -m scripts.garmin_login` once.
GARMIN_TOKENSTORE=~/.garminconnect

# --- Google Calendar (upcoming training) ---
# Google Calendar -> Settings -> (a calendar) -> Integrate calendar ->
# "Secret address in iCal format". Comma-separate to combine several calendars.
# Events here are sorted into training / work / study / reading / personal / other
# by title keywords.
GCAL_ICS_URLS=
# Extra title words per category (comma-separated, added to the built-in lists)
TRAINING_KEYWORDS=
WORK_KEYWORDS=
STUDY_KEYWORDS=
READING_KEYWORDS=
PERSONAL_KEYWORDS=

# Or give each life area its own calendar — every event in it gets that category
# on the daily dashboard. Events from GCAL_ICS_URLS are categorised by title
# keywords instead (e.g. "lecture" -> study, "meeting" -> work).
GCAL_TRAINING_ICS_URLS=
GCAL_WORK_ICS_URLS=
GCAL_STUDY_ICS_URLS=
GCAL_READING_ICS_URLS=
GCAL_PERSONAL_ICS_URLS=

# Key sessions = tempo, threshold, VO2 max and interval runs, and structured bike
# sessions (sweet spot, FTP, over-unders, NxM reps). Base sessions never count.
# Add extra title words here, or put a ★ in any event title to mark it by hand.
KEY_SESSION_KEYWORDS=

# --- App ---
# true = run on generated sample data (no Garmin/Google needed)
DEMO_MODE=false
# Days of history to pull on first sync
BACKFILL_DAYS=90
# Background re-sync interval in minutes (0 disables)
SYNC_INTERVAL_MINUTES=60
DB_PATH=data/lifedashboard.sqlite3
# Weekly goals (copy goals.example.json to goals.json and edit)
GOALS_PATH=goals.json
